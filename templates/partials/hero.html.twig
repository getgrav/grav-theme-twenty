<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <h1>{{ hero_title }}</h1>
            <p class="hero-subtitle">{{ hero_subtitle }}</p>
            {% if hero_button %}
                <a href="{{ hero_button.url }}" class="btn btn-primary">{{ hero_button.text }}</a>
            {% endif %}
        </div>
        {% if hero_image %}
            <div class="hero-image">
                <img src="{{ hero_image }}" alt="{{ hero_title }}" />
            </div>
        {% endif %}
    </div>
</section>
